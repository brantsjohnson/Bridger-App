{
  "name": "bridger",
  "version": "0.0.1",
  "private": true,
  "description": "Bridger — a private friendship/community app. Monorepo root.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "delight:scaffold": "node scripts/scaffold-delight.mjs",
    "demo": "pnpm --filter @bridger/mobile demo:web",
    "demo:web": "pnpm --filter @bridger/mobile demo:web"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "~6.0.3",
    "prettier": "^3.3.3"
  }
}
