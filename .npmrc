# ============================================
# WHAT THIS FILE DOES (plain English):
# Settings for pnpm (our package installer). React Native / Expo's bundler
# (Metro) does not understand pnpm's default "isolated" folder layout, so we
# tell pnpm to install packages in a flat "hoisted" layout it can read.
# ============================================
node-linker=hoisted
shamefully-hoist=true
strict-peer-dependencies=false
