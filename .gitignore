# ============================================
# WHAT THIS FILE DOES (plain English):
# Tells git which files to NEVER save to the repo. These are things that are
# either generated by tools (build output), downloaded (node_modules), or
# secret (.env files with API keys). Keeping secrets out of git is a hard rule.
# ============================================

# --- Dependencies (downloaded, never committed) ---
node_modules/
.pnpm-store/

# --- Build output / caches ---
dist/
dist-ssr/
build/
# Stray tsc output that sometimes lands next to TypeScript sources (real
# builds go to dist/). Never commit compiled JS beside the .ts it came from.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
.expo/
.expo-shared/
web-build/
.turbo/
coverage/
*.tsbuildinfo

# --- Native build artifacts (generated by Expo prebuild / EAS) ---
apps/mobile/ios/
apps/mobile/android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
google-services.json
*-service-account*.json
pc-api-*.json

# --- SECURITY: environment files hold API keys — never commit them ---
.env
.env.*
!.env.example
apps/api/.env
apps/mobile/.env

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor / OS junk ---
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.local
