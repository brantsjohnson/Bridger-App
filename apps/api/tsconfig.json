{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": false,
    "paths": {
      "@bridger/shared": ["../../packages/shared/src/index.ts"],
      "@bridger/permissions": ["../../packages/permissions/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
