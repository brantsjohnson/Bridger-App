# ============================================
# WHAT THIS FILE DOES (plain English):
# A safe, secret-free TEMPLATE showing which settings the API server needs.
# This file IS committed to git (it has no real values). To set up locally,
# copy it to ".env" and fill in the real values. Never put real keys here.
# ============================================

# Supabase (new key system; login tokens verified via JWKS derived from URL)
SUPABASE_URL=
# The new server secret key (starts with sb_secret_). Replaces legacy service_role.
SUPABASE_SECRET_KEY=
# Session pooler URI: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# AI (server-side only; never put these in the mobile app)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: how often the AI worker polls when run as a long process (ms)
AI_WORKER_INTERVAL_MS=5000
# Assistant founder_only gate (comma-separated user UUIDs).
# Local tip: leave this empty and keep NODE_ENV=development (or set
# ASSISTANT_DEV_OPEN=1) so every signed-in user can open Assistant on localhost.
# In production, set real founder UUIDs (or change admin access mode) — empty = closed.
ASSISTANT_FOUNDER_USER_IDS=
# ASSISTANT_DEV_OPEN=1
# Allow POST /assistant/billy/plus/stub (also on by default when NODE_ENV!=production).
# BILLY_PLUS_STUB=1

# Public web base for shareable links (e.g. the J-name quiz result page).
# Used to build https://<APP_WEB_URL>/q/<token>. Defaults to https://bridger.app.
APP_WEB_URL=https://bridger.app

# Email (co-op portal notifications)
RESEND_API_KEY=
COOP_IDEA_REVIEW_EMAIL=hello@bridger.social

# Co-op admin allowlists
COOP_ADMIN_USERNAMES=
COOP_ADMIN_EMAILS=
ADMIN_API_KEY=

# Admin console (password gate). Never ship these to any client.
# Local default password is brantsjohnson; change in Secrets Manager for prod.
ADMIN_PASSWORD=brantsjohnson
ADMIN_JWT_SECRET=change-me-to-a-long-random-string

# Crypto (email hashing / encryption in the portal)
EMAIL_HMAC_KEY=
EMAIL_ENCRYPTION_KEY=

# Spotify account linking (NOT "Sign in with Spotify" / not Supabase Auth).
# Client secret stays server-side only. Redirect must match the Spotify dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
# Encrypts Spotify refresh tokens at rest. Falls back to EMAIL_ENCRYPTION_KEY if unset.
MUSIC_TOKEN_ENCRYPTION_KEY=

# Apple Music / MusicKit (account link, not Bridger login).
# From Apple Developer: Team ID, Media ID, Media Services Key ID, and the .p8 file.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_MEDIA_ID=
# Prefer a local path to the .p8 (never commit the key file).
APPLE_MUSIC_PRIVATE_KEY_PATH=
# Optional: PEM inline with \n instead of path (Secrets Manager in prod).
# APPLE_MUSIC_PRIVATE_KEY=
# Public API origin used for the MusicKit authorize page + JWT origin claim.
# Example: https://api.bridger.social  (falls back from SPOTIFY_REDIRECT_URI host)
API_PUBLIC_URL=
# Optional override for MusicKit JWT "origin" (defaults to API_PUBLIC_URL).
# APPLE_MUSIC_ORIGIN=

# Product analytics (PostHog). Personal API key stays server-side for person
# purge + admin health. Never put this in the mobile app.
# US cloud ingest is https://us.i.posthog.com; REST API is derived unless you set POSTHOG_API_HOST.
POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# Server
PORT=3000
