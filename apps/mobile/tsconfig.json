{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@bridger/shared": ["../../packages/shared/src/index.ts"],
      "@bridger/permissions": ["../../packages/permissions/src/index.ts"],
      "@bridger/ui": ["../../packages/ui/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
