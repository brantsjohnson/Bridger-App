{
  "name": "@bridger/mobile",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "demo": "EXPO_PUBLIC_FORCE_WELCOME=1 EXPO_PUBLIC_DEMO_UNLOCK=1 expo start",
    "demo:web": "EXPO_PUBLIC_FORCE_WELCOME=1 EXPO_PUBLIC_DEMO_UNLOCK=1 expo start --web --port 8090",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "sync-demo-media": "node ./scripts/sync-demo-media.mjs",
    "eas:build:ios:preview": "eas build -p ios --profile preview",
    "eas:build:ios:production": "eas build -p ios --profile production",
    "eas:submit:ios": "eas submit -p ios --latest",
    "eas:build:android:preview": "eas build -p android --profile preview",
    "eas:build:android:production": "eas build -p android --profile production",
    "eas:submit:android": "eas submit -p android --latest"
  },
