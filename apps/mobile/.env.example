# ============================================
# WHAT THIS FILE DOES (plain English):
# A safe, secret-free TEMPLATE of the app's public settings. Committed to git.
# Copy it to ".env" and fill in the values. Only EXPO_PUBLIC_* vars are read by
# the app; the URL and publishable key are meant to be public (RLS protects data).
# ============================================
EXPO_PUBLIC_SUPABASE_URL=
# The new publishable key from Supabase (starts with sb_publishable_...).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3000

# Product analytics (PostHog). The project API key is write-only and safe to
# ship in the app. Capture stays off until the person opts in under Settings.
# Get these from PostHog → Project settings. Leave blank to skip sending.
# EXPO_PUBLIC_POSTHOG_KEY=phc_...
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# DEMO MODE (force on at launch): fake data + skip sign-in. Handy for localhost.
# Assistant Settings + a stub chat are available in demo so you can try the UI.
# EXPO_PUBLIC_DEMO_MODE=1

# LOCAL PREVIEW: show Welcome (pre-sign-in beats) on every cold start.
# Requires DEMO_MODE off (or no session). Set to 0 when done reviewing.
# EXPO_PUBLIC_FORCE_WELCOME=1

# DEMO UNLOCK (long-press Bridger logo on Sign in): allowed on local / preview
# / internal builds. EAS `preview` and `development` set this to 1; `production`
# sets 0 for now. Flip production later if you want store demos.
# EXPO_PUBLIC_DEMO_UNLOCK=1

# Preview the Events marketing gate even when demo fixtures include a host event.
# EXPO_PUBLIC_FORCE_EVENTS_GATE=1

# QA: force demo-week invite gate locally (matches admin demo week behavior in demo mode).
# EXPO_PUBLIC_DEMO_WEEK=1

# Sign-in chrome. TestFlight / production EAS is locked to "legacy"
# (Google / Apple / email, like today). Set "phone" when you are ready to
# ship SMS OTP. Local default in code is still phone unless this is set.
# EXPO_PUBLIC_AUTH_MODE=phone
# EXPO_PUBLIC_AUTH_MODE=legacy

# Optional public invite base (https://bridger.app). When unset, invites use bridger://
# EXPO_PUBLIC_APP_LINK_BASE=https://bridger.app

# Google sign-in client IDs (public, safe to ship). Get from Google Cloud Console.
# Supabase Auth uses the Web client ID on the server; the app uses OAuth redirect.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# After Google/Apple login, the app returns to bridger://auth/callback.
# Add this to Supabase → Authentication → URL Configuration → Additional Redirect URLs:
#   bridger://auth/callback
#   bridger://**

# RevenueCat (co-op membership IAP). Public SDK key only — safe to ship.
# Use the Test Store key while developing; swap to iOS/Android app keys for release.
# EXPO_PUBLIC_REVENUECAT_API_KEY=test_...
# Optional platform overrides (preferred for production):
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
