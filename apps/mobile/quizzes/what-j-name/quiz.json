{
  "quiz_id": "what_j_name_are_you",
  "title": "Which \"J\" name are you?",
  "version": "1.0",
  "selection_rules": {
    "default": {
      "type": "single_select",
      "min": 1,
      "max": 1
    },
    "best_friends": {
      "type": "multi_select",
      "min": 3,
      "max": 3
    }
  },
  "visual_key": {
    "question": "navy_brutalist_slab",
    "answers": "navy_brutalist_blocks_2up",
    "canvas": "solid_white_no_grid",
    "j_percentage_answer": "same_navy_block",
    "non_j_percentage_answer": "same_navy_block",
    "response_interstitial": "navy_brutalist_message",
    "instruction_commentary": "navy_brutalist_message"
  },
  "scoring": {
    "j_percentage": {
      "description": "Measures how J-coded the user is based on the dark-purple answers in Parts 1 and 2.",
      "point_rule": {
        "dark_purple_answer": 1,
        "light_pink_answer": 0
      },
      "denominator_rule": "Only scorable questions the user actually encounters count toward the denominator.",
      "formula": "round(100 * j_percentage_points / j_percentage_max_points_encountered)",
      "range": [
        0,
        100
      ]
    },
    "j_name": {
      "description": "Determines which specific J-name the user is most like from the eight Part 4 questions.",
      "point_rule": "Each Part 4 answer gives +1 to its mapped J-name.",
      "tie_breaker": {
        "primary": "If tied, use the answer to Part 4 Question 8 (Where’s your pad at?) if its J-name is among the tied leaders.",
        "fallback": "If still tied, compare Questions 7 through 1 in reverse order; the first answer whose J-name is among the tied leaders wins."
      }
    },
    "friend_type": {
      "description": "Hidden friend classification calculated from the same eight Part 4 answers.",
      "point_rule": "Each listed friend signal gets +1. Some answers intentionally score two different friend types.",
      "friend_types": {
        "Brad": "Will help you move",
        "Connor": "Will make a lot of money",
        "Austin": "Has a boat",
        "Mike": "Can still call in 10 years",
        "Ed": "Went to Harvard",
        "Wyatt": "Keeps the bro code",
        "Adam": "His place has a pool",
        "Paul": "Enjoys the gym",
        "Zack": "Spontaneous AF"
      },
      "balance": "Each friend type appears as a scoring opportunity exactly 7 times across Part 4.",
      "tie_breaker": "If friend scores tie, compare Questions 8 through 1 in reverse order and use the most recent answer that contains exactly one of the tied friend types. If none resolves it, select randomly among the tied leaders.",
      "validated_opportunity_counts": {
        "Adam": 7,
        "Austin": 7,
        "Brad": 7,
        "Connor": 7,
        "Ed": 7,
        "Mike": 7,
        "Paul": 7,
        "Wyatt": 7,
        "Zack": 7
      }
    },
    "selected_best_friends": {
      "description": "The three friends selected by the user are stored separately from the hidden friend_type score.",
      "use": "Used later to compare/share quiz results and identify which real friend best matches each selected archetype."
    }
  },
