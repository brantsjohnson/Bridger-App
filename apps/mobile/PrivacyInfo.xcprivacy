<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  WHAT THIS FILE IS (plain English):
  This is Apple's "Privacy Manifest" for the Bridger iOS app. Apple's App
  Store review reads it to know (1) whether we track people across other
  companies' apps, (2) what data we collect, and (3) which "required-reason"
  system APIs we use and why. Every third-party SDK we add must also be
  reflected here.

  WHERE IT LIVES: next to app.json so the iOS build and this manifest stay
  together. When we adopt the Expo config approach we can mirror these values
  into app.json's `ios.privacyManifests`; until then this file is the source.

  STATUS: draft skeleton. We fill it in as features land (per guide-rules
  section 8). It currently declares the honest baseline: we do NOT do ad
  tracking. PostHog (our first-party, consented product analytics) is NOT
  cross-app tracking, so NSPrivacyTracking stays false; we still list the
  data types PostHog and the app collect under NSPrivacyCollectedDataTypes
  as we wire them.
  ============================================================
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- TRACKING: we do not track users across other companies' apps/sites. Keep false. -->
  <key>NSPrivacyTracking</key>
  <false/>

  <!-- TRACKING DOMAINS: only used if NSPrivacyTracking is true. Stays empty for us. -->
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <!-- COLLECTED DATA: fill in as we wire real collection (e.g. PostHog product-analytics events, account data). Must match the App Store data-safety label. -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>

  <!-- REQUIRED-REASON APIs: fill in the system APIs we call and their approved reason codes (e.g. file timestamp, UserDefaults) as they appear in the build. -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array/>
</dict>
</plist>
